# IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Composer
/vendor
composer.phar
composer.lock

# Runtime
/runtime/*
!/runtime/.gitkeep
/infrastructure/runtime/logs/
/infrastructure/runtime/debug/
/infrastructure/runtime/mail/
/infrastructure/runtime/cache/
/infrastructure/runtime/*.log
/infrastructure/runtime/database.sqlite

# Published Assets (Yii2 auto-generated)
/frontend/web/assets/*/
!/frontend/web/assets/.gitkeep
/frontend/assets/*/
!/frontend/assets/.gitkeep
!/frontend/assets/*.php

# Uploads (НЕ коммитим файлы клиентов)
/frontend/web/uploads/*
!/frontend/web/uploads/.gitkeep
/frontend/uploads/*
!/frontend/uploads/.gitkeep

# Config (локальные переопределения конфигов)
/config/db-local.php
/config/db-production.php
/config/params-local.php
.env

# SECURITY: Файлы с паролями и секретами
*DEPLOY*.md
!DEPLOYMENT_GUIDE.md
*COMMANDS*.md
ssh-deploy.sh
deploy.sh
DEPLOY_INFO.txt
SECURITY_AUDIT.md

# SSH туннель (временные файлы)
/tmp/ssh-tunnel-*.pid
.ssh-tunnel.pid

# Tests
phpunit.phar
/phpunit.xml

# Vagrant
/.vagrant

# Documentation (НЕ деплоим на production, оставляем только в Git)
# Эти файлы будут в репозитории, но не попадут на сервер при правильном деплое
# Используйте: rsync --exclude-from=.gitignore или git archive

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Backup files
*.bak
*.backup
*.orig
*.swp

# Temp/Debug files
cookies.txt
*.sqlite
*.log

# Claude/Windsurf
.claude/
.mcp.json

# Lighthouse CI artifacts (generated, no need to commit)
.lighthouseci/

# Build artifacts (widget zips are reproducible from sources)
/outputs/widget.zip
/outputs/amocrm-widget/*.zip
/backend/web/amocrm-widget.zip
/frontend/web/amocrm-widget.zip

# Ad-hoc local test/debug scripts
/test_*.php
