<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../tests/bootstrap.php"
         colors="true"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="true"
         cacheResult="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    
    <testsuites>
        <testsuite name="Unit">
            <directory>../../tests/unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>../../tests/integration</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>../../tests/functional</directory>
        </testsuite>
    </testsuites>
    
    <coverage>
        <include>
            <directory suffix=".php">../../backend/modules</directory>
            <directory suffix=".php">../../backend/shared</directory>
            <directory suffix=".php">../../backend/cache</directory>
            <directory suffix=".php">../../backend/decorators</directory>
            <directory suffix=".php">../../backend/search</directory>
            <directory suffix=".php">../../infrastructure</directory>
        </include>
        <exclude>
            <directory>../../vendor</directory>
            <directory>../../infrastructure/runtime</directory>
            <directory>../../tests</directory>
            <directory>../../frontend/web</directory>
        </exclude>
        <report>
            <html outputDirectory="coverage"/>
            <text outputFile="php://stdout"/>
            <clover outputFile="coverage/clover.xml"/>
        </report>
    </coverage>
    
    <php>
        <env name="YII_ENV" value="test"/>
        <env name="YII_DEBUG" value="true"/>
    </php>
</phpunit>
