{
  "widget": {
    "name": "СНИКЕРХЭД",
    "description": "Создание заказов магазина СНИКЕРХЭД прямо из карточки сделки AmoCRM",
    "short_description": "Заказы СНИКЕРХЭД в AmoCRM",
    "version": "1.0.0",
    "interface_version": 2,
    "init_once": true,
    "locale": ["ru", "en"],
    "installation": true,
    "widget_locations": ["lead_card", "settings"],
    "settings": {
      "api_url": {
        "name": "URL магазина (без слеша в конце)",
        "type": "text",
        "required": true,
        "placeholder": "https://sneakerhead.by"
      },
      "api_key": {
        "name": "API-ключ (из настроек плагина AmoCRM)",
        "type": "pass",
        "required": true
      }
    },
    "support": {
      "link": "https://sneakerhead.by/support",
      "email": "support@sneakerhead.by"
    }
  }
}
