{# Lead card widget template — rendered in the right sidebar #}
<div id="sneakerhead-widget-wrap" class="sh-widget-wrap">
  <div class="sh-loading">Загрузка...</div>
</div>

<style>
.sh-widget-wrap { font-family: inherit; font-size: 13px; }
.sh-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
.sh-table td { padding: 4px 6px; vertical-align: top; }
.sh-table td:first-child { color: #888; width: 100px; }
.sh-link { color: #1758f2; text-decoration: none; }
.sh-link:hover { text-decoration: underline; }
.sh-badge { padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
.sh-badge-new        { background: #dbeafe; color: #1e40af; }
.sh-badge-paid       { background: #dcfce7; color: #166534; }
.sh-badge-processing { background: #fef9c3; color: #854d0e; }
.sh-badge-shipped    { background: #e0f2fe; color: #075985; }
.sh-badge-delivered  { background: #d1fae5; color: #065f46; }
.sh-badge-cancelled  { background: #fee2e2; color: #991b1b; }
.sh-actions { margin-top: 8px; }
.sh-empty, .sh-error, .sh-loading { color: #888; font-size: 12px; padding: 8px 0; }
.sh-error { color: #e53e3e; }
</style>
