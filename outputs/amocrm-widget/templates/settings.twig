{# Widget settings page template — field names must match manifest.json settings keys #}
<div class="sh-settings-wrap">
  <p style="color:#555;font-size:13px;margin-bottom:16px">
    Виджет отображает данные заказа СНИКЕРХЭД на карточке сделки AmoCRM.
  </p>

  <div class="sh-field">
    <label>URL магазина</label>
    <input type="text" name="api_url" class="text-input"
           placeholder="https://sneakerhead.by"
           value="{{ settings.api_url }}">
    <span class="sh-hint">Без слеша в конце. Например: https://sneakerhead.by</span>
  </div>

  <div class="sh-field" style="margin-top:12px">
    <label>API-ключ</label>
    <input type="password" name="api_key" class="text-input"
           placeholder="••••••••••••••••••••••"
           value="{{ settings.api_key }}">
    <span class="sh-hint">Получите в настройках магазина: <em>Настройки → Плагины → AmoCRM → API-ключ виджета</em></span>
  </div>

  <style>
  .sh-settings-wrap { max-width: 480px; }
  .sh-field label { display:block; font-weight:600; margin-bottom:4px; font-size:13px; }
  .sh-hint { display:block; font-size:11px; color:#888; margin-top:3px; }
  </style>
</div>
