{# Widget settings page template #}
<div class="sh-settings-wrap">
  <p style="color:#555;font-size:13px;margin-bottom:16px">
    Виджет отображает данные заказа SneakerHead на карточке сделки AmoCRM.
  </p>

  <div class="sh-field">
    <label>URL магазина</label>
    <input type="text" name="shop_url" class="text-input"
           placeholder="https://your-shop.com"
           value="{{ settings.shop_url }}">
    <span class="sh-hint">Без слеша в конце. Должен совпадать с URL, по которому доступен API.</span>
  </div>

  <div class="sh-field" style="margin-top:12px">
    <label>API токен</label>
    <input type="text" name="api_token" class="text-input"
           placeholder="sneakerhead_api_xxxxxxxxxxxxxxxx"
           value="{{ settings.api_token }}">
    <span class="sh-hint">Получите токен в настройках плагина AmoCRM: <em>Настройки → Плагины → AmoCRM → Настройки → API токен</em></span>
  </div>

  <style>
  .sh-settings-wrap { max-width: 480px; }
  .sh-field label { display:block; font-weight:600; margin-bottom:4px; font-size:13px; }
  .sh-hint { display:block; font-size:11px; color:#888; margin-top:3px; }
  </style>
</div>
