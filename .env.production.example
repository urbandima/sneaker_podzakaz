# ===============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===============================================
# Скопируйте этот файл в .env.production и заполните реальными значениями

# --- Application Environment ---
YII_ENV=prod
YII_DEBUG=false

# --- Security ---
COOKIE_VALIDATION_KEY=<GENERATE_WITH: openssl rand -hex 32>
HEALTH_CHECK_TOKEN=<GENERATE_WITH: openssl rand -hex 32>  # shared secret for uptime monitor: /admin/health?token=... or X-Health-Token header

# --- Database Configuration ---
DB_DSN=mysql:host=localhost;dbname=sneakerhead_prod;charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sneakerhead_prod
DB_USER=sneakerhead_user
DB_PASSWORD=<STRONG_PASSWORD>
DB_CHARSET=utf8mb4

# --- Database Performance ---
DB_SCHEMA_CACHE=true
DB_SCHEMA_CACHE_DURATION=3600
DB_TIMEOUT=5

# --- Email Configuration ---
# CMP-464: боевой домен подтверждён живым HTTP-запросом — sneaker-head.by
# (через дефис). sneakerhead.by (без дефиса) резолвится на другой IP и не
# отвечает; sneakerculture.by — вообще не тот сайт (см. CMP-285).
MAIL_USE_FILE_TRANSPORT=false
MAIL_FROM_EMAIL=noreply@sneaker-head.by
MAIL_FROM_NAME=СНИКЕРХЭД

# --- SMTP Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=<APP_PASSWORD>
SMTP_ENCRYPTION=tls

# --- Poizon API Configuration ---
POIZON_API_URL=https://api.poizon-parser.com/v1
POIZON_API_KEY=<YOUR_API_KEY>
POIZON_XML_URL=<YOUR_XML_FEED_URL>

# --- Currency Exchange Rate ---
CNY_TO_BYN_RATE=0.45

# --- Company Details ---
COMPANY_NAME=ООО "СНИКЕРХЭД"
COMPANY_UNP=123456789
COMPANY_ADDRESS=г. Минск, ул. Тестовая, д. 1
COMPANY_PHONE=+375 29 123-45-67
COMPANY_EMAIL=info@sneaker-head.by

# --- Admin Contact ---
ADMIN_EMAIL=admin@sneaker-head.by

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_DATABASE=0

# --- Elasticsearch Configuration ---
ELASTICSEARCH_HOST=localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- Sentry Error Tracking ---
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Security Settings ---
SESSION_LIFETIME=1440
CSRF_TOKEN_LIFETIME=7200

# --- CDN Configuration ---
CDN_URL=https://cdn.sneaker-head.by
CDN_TYPE=cloudflare
APP_VERSION=1.0.0

# --- CloudFlare CDN ---
CLOUDFLARE_ZONE_ID=<YOUR_ZONE_ID>
CLOUDFLARE_API_TOKEN=<YOUR_API_TOKEN>

# --- Payment Gateways ---
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
YANDEX_KASSA_CLIENT_ID=<YOUR_CLIENT_ID>
YANDEX_KASSA_CLIENT_SECRET=<YOUR_SECRET>

# --- Social Networks ---
FACEBOOK_APP_ID=<YOUR_APP_ID>
FACEBOOK_APP_SECRET=<YOUR_SECRET>
VKONTAKTE_APP_ID=<YOUR_APP_ID>
VKONTAKTE_APP_SECRET=<YOUR_SECRET>

# --- Monitoring ---
SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_CHAT_ID>

# --- Site URL ---
FRONTEND_URL=https://sneaker-head.by

# --- OAuth (social login) ---
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
YANDEX_CLIENT_ID=<YOUR_YANDEX_CLIENT_ID>
YANDEX_CLIENT_SECRET=<YOUR_YANDEX_CLIENT_SECRET>
TELEGRAM_CLIENT_ID=<YOUR_TELEGRAM_BOT_ID>
TELEGRAM_CLIENT_SECRET=<YOUR_TELEGRAM_BOT_TOKEN>

# --- Redis (additional) ---
REDIS_DB=0

# --- Delivery provider (DobroPost) ---
DP_API_URL=https://api.dobropost.com
DP_API_EMAIL=<YOUR_DP_EMAIL>
DP_API_PASSWORD=<YOUR_DP_PASSWORD>
DP_DEFAULT_TARIFF=26

# --- SMS Provider ---
SMS_PROVIDER=rocketsms
SMS_SENDER=<YOUR_SMS_SENDER_NAME>
ROCKETSMS_USERNAME=<YOUR_ROCKETSMS_USERNAME>
ROCKETSMS_PASSWORD=<YOUR_ROCKETSMS_PASSWORD>
ROCKETSMS_SENDER=<YOUR_ROCKETSMS_SENDER>
SMSC_LOGIN=<YOUR_SMSC_LOGIN>
SMSC_PASSWORD=<YOUR_SMSC_PASSWORD>
SMSRU_API_ID=<YOUR_SMSRU_API_ID>
TWILIO_SID=<YOUR_TWILIO_SID>
TWILIO_TOKEN=<YOUR_TWILIO_TOKEN>
TWILIO_FROM=<YOUR_TWILIO_FROM_NUMBER>
